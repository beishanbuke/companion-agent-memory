DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# Optional: two-stage long-term memory extraction
MEMORY_LLM_API_KEY=your_memory_llm_api_key
MEMORY_LLM_URL=https://api2.aigcbest.top/v1/chat/completions
MEMORY_LLM_MODEL=gpt-4o-mini

# Optional: Connect via Daily WebRTC locally
DAILY_API_KEY=your_daily_api_key

# Optional: voice STT provider, default volcengine
# STT_PROVIDER=volcengine

# Optional: tune Volcengine streaming STT for stability/accuracy
# VOLCENGINE_ASR_MODEL_NAME=bigmodel
# VOLCENGINE_ASR_ENABLE_ITN=true
# VOLCENGINE_ASR_ENABLE_PUNC=true
# VOLCENGINE_ASR_ENABLE_DDC=false
# VOLCENGINE_ASR_SHOW_UTTERANCES=true
# VOLCENGINE_ASR_RESULT_TYPE=single
# VOLCENGINE_ASR_FINAL_WAIT_MS=900
# VOLCENGINE_ASR_FALLBACK_FINALIZE=true
# VOLCENGINE_ASR_FALLBACK_MIN_CHARS=4
# VOLCENGINE_ASR_CHUNK_MS=200
# VOLCENGINE_ASR_MIN_STABLE_SEC=0.8
# VOLCENGINE_ASR_MAX_QUICK_FAILURES=12

# Optional: VAD tuning (higher stop_secs usually improves recognition completeness)
# VOICE_VAD_START_SECS=0.18
# VOICE_VAD_STOP_SECS=0.35
# VOICE_VAD_CONFIDENCE=0.7
# VOICE_VAD_MIN_VOLUME=0.5

# Optional: context engineering feature flags for prototype_demo/server.py
# ENABLE_SCENE_ROUTER=true
# ENABLE_CONTEXT_PACKER_V2=true
# ENABLE_MEMORY_RERANK_V2=true
